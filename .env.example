# =============================================================================
# Agri-Agent Swarm — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ── API Keys ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "groq" (recommended, higher free-tier limits) | "gemini"
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here

# ── Server ────────────────────────────────────────────────────────────────────
# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-generated-64-char-hex-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── User Credentials ──────────────────────────────────────────────────────────
# Operator — full access: run analysis, approve/reject irrigation
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password-here

# Viewer — read-only: history, stats, analytics dashboard
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=your-strong-viewer-password-here

# ── Database (optional overrides) ─────────────────────────────────────────────
SQLITE_HISTORY_DB=history.db
SQLITE_CHECKPOINTS_DB=checkpoints.sqlite
CHROMA_PERSIST_DIR=./chroma_db

# ── Farm Defaults (overridable per-request) ───────────────────────────────────
DEFAULT_LATITUDE=35.6911
DEFAULT_LONGITUDE=-0.6328
